# 복사해서 .env.local로 저장한 뒤 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
GEMINI_API_KEY=
# 선택: 모델 변경 (기본값 gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# 선택: Gemini 주소 변경 (Cloudflare AI Gateway 같은 중계 주소, .../models 까지)
# GEMINI_BASE_URL=

# 선택: 접근 코드. 값을 넣으면 이 코드를 아는 사람만 화면과 AI 기능을 쓸 수 있습니다.
# 비워 두면 잠금이 꺼집니다 (로컬 개발용). 배포(Cloudflare)에서는 Secret으로 등록하세요.
# APP_ACCESS_CODE=

# (선택) 실시간 시세 API. 없으면 해당 기능만 "키 미등록" 안내가 나오고 나머지는 그대로 동작합니다.
# 항공 최저가 날짜 조회: travelpayouts.com 가입 후 Tools > API 에서 발급
TRAVELPAYOUTS_TOKEN=
# 투어 실제 판매가/평점 조회: Viator Partner(제휴) 가입 후 발급한 API 키
VIATOR_API_KEY=

# (선택) 여행경보 예비 조회용. 기본은 0404.go.kr을 키 없이 바로 쓰므로 이 키는 없어도 됩니다.
# 0404.go.kr이 막히거나 응답을 바꿀 때의 예비 경로로, 공공데이터포털에서 "외교부_국가·지역별 여행경보" 활용 신청(자동승인) 후 발급한 일반 인증키(Decoding)를 넣습니다.
DATA_GO_KR_KEY=
