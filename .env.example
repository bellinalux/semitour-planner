# 복사해서 .env.local로 저장한 뒤 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# 무료 키: 결제를 연결하지 않은 AI Studio 프로젝트에서 발급 (같은 프로젝트에서 키를 더 만들어도 한도는 늘지 않음)
GEMINI_API_KEY=
# 선택: Gemini 예비 키 — 주 키가 크레딧 소진·한도·키 오류면 같은 요청을 이 키로 다시 보냄 (예: 무료 주 키 + 결제 연결 예비 키)
# 무료 한도를 늘리려고 무료 키를 여러 개 돌려 쓰는 용도는 Google 약관(사용량 제한 우회 금지)에 걸릴 수 있음
# GEMINI_BACKUP_API_KEY=
# 선택: 모델 변경 (기본값 gemini-flash-lite-latest — 무료 한도가 가장 넉넉함)
# GEMINI_MODEL=gemini-3.8-flash
# 선택: 기본 모델이 붐빌 때(503) 한 번 더 시도할 다른 Gemini 모델 (기본: lite면 gemini-flash-latest, 아니면 gemini-flash-lite-latest / off면 안 씀)
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
# 선택: Gemini 주소 변경 (Cloudflare AI Gateway 같은 중계 주소, .../models 까지)
# GEMINI_BASE_URL=

# 선택: 접근 코드. 값을 넣으면 이 코드를 아는 사람만 화면과 AI 기능을 쓸 수 있습니다.
# 비워 두면 잠금이 꺼집니다 (로컬 개발용). 배포(Cloudflare)에서는 Secret으로 등록하세요.
# APP_ACCESS_CODE=

# (선택) 앱 "AI 키 설정"에 넣은 키를 암호화하는 비밀값. 없으면 APP_ACCESS_CODE로 암호화(코드를 바꾸면 키 다시 입력)
# APP_SECRET_KEY=

# (선택) 대체 AI — Gemini가 한도·크레딧 소진·장애로 안 되면 이 순서로 이어 받는다
# AI_PROVIDERS=gemini,groq,openrouter,cloudflare
# Groq: console.groq.com에서 무료 발급. 검색 조사는 웹 검색이 들어 있는 groq/compound 모델을 쓴다
GROQ_API_KEY=
# 모델은 계정에서 쓸 수 있는 것을 자동으로 고른다 (무료 등급 모델이 자주 바뀜). 고정하려면:
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SEARCH_MODEL=groq/compound
# OpenRouter 무료(:free) 모델 — openrouter.ai에서 키 발급 (무료 하루 50회, $10 충전 시 하루 1,000회)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Tavily 웹 검색 — Gemini 없이도 웹 근거 있는 조사 (무료 월 사용량)
TAVILY_API_KEY=
# Cloudflare Workers AI: 키 없음 — wrangler.jsonc의 "ai" 바인딩으로 연결된다(하루 무료 사용량 안에서, 웹 검색 없음)
# CF_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct (문맥 131k)

# (선택) 실시간 시세 API. 없으면 해당 기능만 "키 미등록" 안내가 나오고 나머지는 그대로 동작합니다.
# 항공 최저가 날짜 조회: travelpayouts.com 가입 후 Tools > API 에서 발급
TRAVELPAYOUTS_TOKEN=
# 투어 실제 판매가/평점 조회: Viator Partner(제휴) 가입 후 발급한 API 키
VIATOR_API_KEY=

# (선택) 여행경보 예비 조회용. 기본은 0404.go.kr을 키 없이 바로 쓰므로 이 키는 없어도 됩니다.
# 0404.go.kr이 막히거나 응답을 바꿀 때의 예비 경로로, 공공데이터포털에서 "외교부_국가·지역별 여행경보" 활용 신청(자동승인) 후 발급한 일반 인증키(Decoding)를 넣습니다.
DATA_GO_KR_KEY=

# 선택: 무료 도로 경로(OpenRouteService, https://openrouteservice.org) — 구글 지도 키가 없을 때 장소 사이 실제 도로 이동 시간
# ORS_API_KEY=
